@page "/"
@using FinDashboardBlazor.Models
@using FinDashboardBlazor.Services

@inject FinancialDataService FinancialService

<PageTitle>Financial Dashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-primary">Financial Analytics Dashboard</h2>
            <p class="text-muted">Comprehensive financial data analysis with Syncfusion Blazor Pivot Table</p>
        </div>
    </div>

    <!-- Enhanced Summary Cards -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <SfCard CssClass="border-success shadow-sm h-100">
                <CardContent>
                    <div class="text-center">
                        <i class="fas fa-arrow-up text-success fs-1 mb-2"></i>
                        <h3 class="text-success fw-bold">@totalIncome.ToString("C0")</h3>
                        <p class="text-success mb-0">Total Income</p>
                        <small class="text-muted">@incomeTransactionCount transactions</small>
                    </div>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <SfCard CssClass="border-danger shadow-sm h-100">
                <CardContent>
                    <div class="text-center">
                        <i class="fas fa-arrow-down text-danger fs-1 mb-2"></i>
                        <h3 class="text-danger fw-bold">@totalExpenses.ToString("C0")</h3>
                        <p class="text-danger mb-0">Total Expenses</p>
                        <small class="text-muted">@expenseTransactionCount transactions</small>
                    </div>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <SfCard CssClass="border-info shadow-sm h-100">
                <CardContent>
                    <div class="text-center">
                        <i class="fas fa-chart-line text-info fs-1 mb-2"></i>
                        <h3 class="text-info fw-bold">@netProfit.ToString("C0")</h3>
                        <p class="text-info mb-0">Net Profit</p>
                        <small class="text-muted">@(netProfit >= 0 ? "Positive" : "Negative") margin</small>
                    </div>
                </CardContent>
            </SfCard>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <SfCard CssClass="border-primary shadow-sm h-100">
                <CardContent>
                    <div class="text-center">
                        <i class="fas fa-file-invoice-dollar text-primary fs-1 mb-2"></i>
                        <h3 class="text-primary fw-bold">@transactions.Count</h3>
                        <p class="text-primary mb-0">Total Transactions</p>
                        <small class="text-muted">Across @uniqueDepartments departments</small>
                    </div>
                </CardContent>
            </SfCard>
        </div>
    </div>

    <!-- Main Dashboard Layout -->
    <SfDashboardLayout Columns="12" CellSpacing="@(new double[] { 15, 15 })" AllowDragging="true" AllowResizing="true">
        <DashboardLayoutPanels>
            <!-- Primary Pivot Table Panel -->
            <DashboardLayoutPanel Id="pivotPanel" Row="0" Column="0" SizeX="12" SizeY="6">
                <HeaderTemplate>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-table-cells text-primary fs-4 me-2"></i>
                            <span class="fw-semibold">Financial Data Analysis - Pivot Table</span>
                        </div>
                        <small class="text-muted">Drag fields to analyze data dynamically</small>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <SfPivotView TValue="FinancialData" @ref="pivotViewRef" Width="100%" Height="100%"
                    ShowFieldList="true" ShowGroupingBar="true" ShowToolbar="true" EnableValueSorting="true">
                        <PivotViewDataSourceSettings DataSource="@transactions" EnableSorting="true" ExpandAll="false"
                        ShowGrandTotals="true" ShowSubTotals="true" AllowLabelFilter="true" AllowValueFilter="true">
                            <PivotViewColumns>
                                <PivotViewColumn Name="Year" Caption="Year"></PivotViewColumn>
                                <PivotViewColumn Name="Quarter" Caption="Quarter"></PivotViewColumn>
                            </PivotViewColumns>
                            <PivotViewRows>
                                <PivotViewRow Name="Department" Caption="Department"></PivotViewRow>
                                <PivotViewRow Name="Category" Caption="Category"></PivotViewRow>
                                <PivotViewRow Name="Type" Caption="Transaction Type"></PivotViewRow>
                            </PivotViewRows>
                            <PivotViewValues>
                                <PivotViewValue Name="Amount" Caption="Total Amount" Type="SummaryTypes.Sum"></PivotViewValue>
                                <PivotViewValue Name="Budget" Caption="Total Budget" Type="SummaryTypes.Sum"></PivotViewValue>
                                <PivotViewValue Name="Variance" Caption="Total Variance" Type="SummaryTypes.Sum"></PivotViewValue>
                            </PivotViewValues>
                            <PivotViewFilters>
                                <PivotViewFilter Name="Region" Caption="Region"></PivotViewFilter>
                                <PivotViewFilter Name="Status" Caption="Status"></PivotViewFilter>
                                <PivotViewFilter Name="Priority" Caption="Priority"></PivotViewFilter>
                            </PivotViewFilters>
                            <PivotViewFormatSettings>
                                <PivotViewFormatSetting Name="Amount" Format="C0" UseGrouping="true"></PivotViewFormatSetting>
                                <PivotViewFormatSetting Name="Budget" Format="C0" UseGrouping="true"></PivotViewFormatSetting>
                                <PivotViewFormatSetting Name="Variance" Format="C0" UseGrouping="true"></PivotViewFormatSetting>
                            </PivotViewFormatSettings>
                        </PivotViewDataSourceSettings>
                        <PivotViewDisplayOption View="View.Both" Primary="Primary.Table"></PivotViewDisplayOption>
                        <PivotViewGridSettings ColumnWidth="120" RowHeight="36" AllowSelection="true"
                        GridLines="Syncfusion.Blazor.PivotView.PivotTableGridLine.Both" AllowResizing="true" AllowReordering="true"></PivotViewGridSettings>
                        <PivotViewEvents TValue="FinancialData"></PivotViewEvents>
                    </SfPivotView>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <!-- Regional Performance Chart -->
            <DashboardLayoutPanel Id="regionChartPanel" Row="6" Column="0" SizeX="6" SizeY="4">
                <HeaderTemplate>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-globe text-success fs-5 me-2"></i>
                        <span class="fw-semibold">Regional Financial Performance</span>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <SfChart Width="100%" Height="100%" Theme="Theme.Bootstrap5">
                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"
                        LabelRotation="-45" Title="Regions" />
                        <ChartPrimaryYAxis LabelFormat="${value}" Title="Amount (USD)" />
                        <ChartSeriesCollection>
                            <ChartSeries DataSource="@regionalData" XName="Region" YName="Income"
                            Name="Income" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column" Fill="#28a745" />
                            <ChartSeries DataSource="@regionalData" XName="Region" YName="Expenses"
                            Name="Expenses" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column" Fill="#dc3545" />
                        </ChartSeriesCollection>
                        <ChartTooltipSettings Enable="true" Format="${point.x}: ${point.y}" />
                        <ChartLegendSettings Visible="true" Position="LegendPosition.Top" />
                    </SfChart>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <!-- Departmental Analysis -->
            <DashboardLayoutPanel Id="deptChartPanel" Row="6" Column="6" SizeX="6" SizeY="4">
                <HeaderTemplate>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-building text-primary fs-5 me-2"></i>
                        <span class="fw-semibold">Department-wise Analysis</span>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <SfChart Width="100%" Height="100%" Theme="Theme.Bootstrap5">
                        <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" />
                        <ChartPrimaryYAxis />
                        <ChartSeriesCollection>
                            <ChartSeries DataSource="@departmentalData" XName="Department" YName="Amount"
                            Name="Total Amount" Type="Syncfusion.Blazor.Charts.ChartSeriesType.Column" />
                        </ChartSeriesCollection>
                        <ChartTooltipSettings Enable="true" Format="${point.x}: ${point.y} (${point.percentage}%)" />
                        <ChartLegendSettings Visible="true" Position="LegendPosition.Right" />
                    </SfChart>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <!-- Enhanced Data Grid Panel -->
            <DashboardLayoutPanel Id="gridPanel" Row="10" Column="0" SizeX="12" SizeY="5">
                <HeaderTemplate>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-list text-info fs-5 me-2"></i>
                            <span class="fw-semibold">Detailed Transaction Records</span>
                        </div>
                        <small class="text-muted">@filteredTransactions.Count of @transactions.Count records</small>
                    </div>
                </HeaderTemplate>
                <ContentTemplate>
                    <SfGrid @ref="gridRef" DataSource="@filteredTransactions" AllowPaging="true" AllowSorting="true"
                    AllowFiltering="true" Height="100%" ShowColumnChooser="true">
                        <GridPageSettings PageSize="15" />
                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
                        <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                        <GridColumns>
                            <GridColumn Field="@nameof(FinancialData.TransactionID)" HeaderText="ID" Width="80" IsPrimaryKey="true" />
                            <GridColumn Field="@nameof(FinancialData.Date)" HeaderText="Date" Format="MMM dd, yyyy" Width="120" />
                            <GridColumn Field="@nameof(FinancialData.Description)" HeaderText="Description" Width="180" />
                            <GridColumn Field="@nameof(FinancialData.Department)" HeaderText="Department" Width="120" />
                            <GridColumn Field="@nameof(FinancialData.Category)" HeaderText="Category" Width="120" />
                            <GridColumn Field="@nameof(FinancialData.Region)" HeaderText="Region" Width="130" />
                            <GridColumn Field="@nameof(FinancialData.Type)" HeaderText="Type" Width="100">
                                <Template>
                                    @{
                                        var transaction = (FinancialData)context;
                                        var badgeClass = transaction.Type == "Income" ? "badge bg-success" : "badge bg-danger";
                                    }
                                    <span class="@badgeClass">@transaction.Type</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(FinancialData.Amount)" HeaderText="Amount" Format="C2" Width="120" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(FinancialData.Budget)" HeaderText="Budget" Format="C2" Width="120" TextAlign="TextAlign.Right" />
                            <GridColumn Field="@nameof(FinancialData.Variance)" HeaderText="Variance" Format="C2" Width="120" TextAlign="TextAlign.Right">
                                <Template>
                                    @{
                                        var transaction = (FinancialData)context;
                                        var varianceClass = transaction.Variance >= 0 ? "text-success" : "text-danger";
                                    }
                                    <span class="@varianceClass fw-bold">@transaction.Variance.ToString("C2")</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(FinancialData.Status)" HeaderText="Status" Width="100">
                                <Template>
                                    @{
                                        var transaction = (FinancialData)context;
                                        var statusClass = transaction.Status switch
                                        {
                                            "Approved" => "badge bg-success",
                                            "Pending" => "badge bg-warning text-dark",
                                            "Processing" => "badge bg-info",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@statusClass">@transaction.Status</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(FinancialData.Priority)" HeaderText="Priority" Width="100" />
                        </GridColumns>
                    </SfGrid>
                </ContentTemplate>
            </DashboardLayoutPanel>
        </DashboardLayoutPanels>
    </SfDashboardLayout>
</div>
@code{
    private List<FinancialData> transactions = new();
    private List<FinancialData> filteredTransactions = new();
    private List<RegionalData> regionalData = new();
    private List<DepartmentalData> departmentalData = new();
    private decimal totalIncome = 0;
    private decimal totalExpenses = 0;
    private decimal netProfit = 0;
    private int incomeTransactionCount = 0;
    private int expenseTransactionCount = 0;
    private int uniqueDepartments = 0;

    private SfPivotView<FinancialData>? pivotViewRef;
    private SfGrid<FinancialData>? gridRef;

    protected override void OnInitialized()
    {
        transactions = FinancialService.GetFinancialData();
        filteredTransactions = transactions;

        CalculateMetrics();
        PrepareChartData();
    }

    private void CalculateMetrics()
    {
        totalIncome = transactions.Where(t => t.Type == "Income").Sum(t => t.Amount);
        totalExpenses = transactions.Where(t => t.Type == "Expense").Sum(t => t.Amount);
        netProfit = totalIncome - totalExpenses;
        incomeTransactionCount = transactions.Count(t => t.Type == "Income");
        expenseTransactionCount = transactions.Count(t => t.Type == "Expense");
        uniqueDepartments = transactions.Select(t => t.Department).Distinct().Count();
    }

    private void PrepareChartData()
    {
        regionalData = transactions
            .GroupBy(t => t.Region)
            .Select(g => new RegionalData
                {
                    Region = g.Key,
                    Income = g.Where(x => x.Type == "Income").Sum(x => x.Amount),
                    Expenses = g.Where(x => x.Type == "Expense").Sum(x => x.Amount)
                })
            .ToList();

        departmentalData = transactions
            .GroupBy(t => t.Department)
            .Select(g => new DepartmentalData
                {
                    Department = g.Key,
                    Amount = g.Sum(x => x.Amount)
                })
            .ToList();
    }

    public class RegionalData
    {
        public string Region { get; set; } = string.Empty;
        public decimal Income { get; set; }
        public decimal Expenses { get; set; }
    }

    public class DepartmentalData
    {
        public string Department { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }
}
